{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile",
        "watchPatterns": [
            "Dockerfile",
            "railway.json",
            "docker/site.toml",
            "pyproject.toml",
            "uv.lock",
            "hatch_build.py",
            "README.md",
            "src/**",
            "frontend/**"
        ]
    },
    "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
